# Settings for the Docker Compose setup. Copy to .env.docker (not committed)
# and replace every placeholder, then run:
#   docker compose --env-file .env.docker up -d --build

# PostgreSQL inside Docker. The database is created on first start and is
# separate from any PostgreSQL installed directly on your machine.
POSTGRES_DB=uniswap
POSTGRES_USER=uniswap
POSTGRES_PASSWORD=replace_with_a_local_database_password

# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Port on your machine where the API is published (http://localhost:3000)
API_PORT=3000

# Frontend origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Leave empty to run without the AI assistant (POST /ai/chat returns 503).
OPENAI_API_KEY=
AI_MODEL=
