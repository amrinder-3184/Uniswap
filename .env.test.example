# Copy to .env.test for running the automated tests locally (npm test).
# The test suite loads ONLY .env.test, never .env.
#
# DB_NAME must end in _test and DB_HOST must be a local host, otherwise the
# suite refuses to run. Every test empties the tables of this database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uniswap_test
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

# Any random string of 32+ characters. Must not be your real JWT secret.
JWT_SECRET=replace_with_a_random_test_only_secret_of_32_plus_chars

# Fake key + unreachable local URL so tests can never call the real OpenAI API
OPENAI_API_KEY=sk-test-not-a-real-key
OPENAI_BASE_URL=http://127.0.0.1:9/v1

ALLOWED_ORIGINS=http://localhost:5173

# Optional: extra hostnames allowed for the test database (comma-separated),
# e.g. a Docker Compose service name. localhost/127.0.0.1/::1 are always allowed.
# TEST_DB_ALLOWED_HOSTS=db
