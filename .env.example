# Settings for running the API directly with Node.js (npm start / node index.js)
# against a PostgreSQL server on your machine. Copy to .env (not committed).

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=uniswap_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

# 32+ random characters; the server refuses to start with a short or placeholder value
JWT_SECRET=replace_with_a_long_random_string

# Optional. Without a key the API runs; only POST /ai/chat returns 503.
OPENAI_API_KEY=
AI_MODEL=
